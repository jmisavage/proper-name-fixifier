{
    "name": "proper-name-fixifier",
    "version": "2.0.0",
    "description": "convert all upper case and lower case names to their proper case",
    "main": "dist/index.js",
    "typings": "dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jmisavage/proper-name-fixifier.git"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "vitest run",
        "lint": "oxlint",
        "format": "oxfmt src",
        "format:check": "oxfmt --check src",
        "prepublishOnly": "npm run build"
    },
    "keywords": [],
    "author": "Jeremy Misavage",
    "license": "MIT",
    "devDependencies": {
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "typescript": "^5.7.2",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22"
    }
}
