{
    "compilerOptions": {
        "target": "es2022",
        "module": "node16",
        "lib": ["es2022"],
        "declaration": true,
        "outDir": "dist/",
        "rootDir": "src/",
        "removeComments": true,
        "resolveJsonModule": true,
        "strict": true,
        "esModuleInterop": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules/", "src/**/*.spec.ts"]
}
